{ pkgs, ... }:
{
  nix.settings = {
    experimental-features = [
      "nix-command"
      "flakes"
    ];
    auto-optimise-store = true;
  };

  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 10d";
  };

  nixpkgs.config.allowUnfree = true; # hplip plugin, nvidia driver

  environment.systemPackages = [
    pkgs.nix-tree
    pkgs.nix-index
  ];
}
